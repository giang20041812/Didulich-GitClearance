# Backend Environment Variables Example (Node.js)
#
# Dev local: copy các dòng cần thiết vào backend-api/.env.local (đã git-ignore) — `npm run dev` / `npm run migrate` tự đọc file này.
# Production: đặt trong môi trường của nền tảng deploy (Vercel → Environment Variables, VPS → systemd/Docker env).
# Tên biến giữ nguyên như bản Spring Boot cũ nên cấu hình đang có (kể cả DB_URL dạng jdbc:postgresql://…) dùng được ngay.

# Application Setup
# dev: không đặt gì (chạy mặc định). Production VPS (PostgreSQL tự quản): đặt "prod". Supabase/Vercel: đặt "supabase".
# (APP_PROFILE; SPRING_PROFILES_ACTIVE vẫn được đọc để không phải đổi cấu hình cũ.)
PORT=8080
APP_PROFILE=dev

# Database Configuration (PostgreSQL — DB trống thì tự dựng schema từ migrations/*.sql lúc khởi động)
# Chấp nhận cả dạng JDBC lẫn postgres://user:pass@host:5432/db?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/viettrek
DB_USERNAME=postgres
DB_PASSWORD=secret

# JWT Secret — BẮT BUỘC trên production (profile prod/supabase từ chối khởi động nếu thiếu,
# quá ngắn (< 32 ký tự) hoặc trùng giá trị mặc định cũ đã lộ trong git history).
# Sinh secret mới: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long

# Payment Integration (SEPay)
# Webhook /api/v1/webhooks/sepay xác thực header "Authorization: Apikey <secret>" từ SEPay.
# Chưa triển khai đối soát tự động — endpoint trả 501 khi secret đúng (xem DEPLOY.md mục thanh toán).
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_for_validation

# Active Media Provider (CLOUDINARY hoặc SUPABASE)
ACTIVE_MEDIA_PROVIDER=CLOUDINARY

# --- Bản đồ & geocoding (miễn phí) ---
# Geocoding cho NCC nhập tọa độ homestay. AUTO: dùng VietMap khi có VIETMAP_API_KEY
# (gói miễn phí của console.vietmap.vn, consumer loại "Services" với quyền Search/Place),
# ngược lại tự dùng Nominatim của OpenStreetMap — miễn phí, mã nguồn mở, KHÔNG cần key.
# Ép provider: VIETMAP | NOMINATIM.
VIETMAP_API_KEY=
GEOCODING_PROVIDER=AUTO
# User-Agent nhận diện ứng dụng — chính sách Nominatim yêu cầu; nên ghi kèm liên hệ thật.
NOMINATIM_USER_AGENT=VietTrekBooking/1.0 (https://viettrek-app.vercel.app; contact: admin@dulichso.vn)

# Thời tiết điểm đến qua Open-Meteo (mã nguồn mở, miễn phí, không cần key).
# Dữ liệu CC BY 4.0 — UI đã ghi attribution "Open-Meteo". Đặt false để tắt.
WEATHER_ENABLED=true

# Cloudinary Setup (Media Storage) — KHÔNG lưu secret trong source; đã có secret lộ trên git phải đổi (rotate) ở Cloudinary.
# Thiếu 3 biến này thì tải ảnh lên báo lỗi.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Supabase Storage (khi ACTIVE_MEDIA_PROVIDER=SUPABASE; ảnh tải qua backend bằng service key)
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_STORAGE_BUCKET=viettrek-media

# Web Push (VAPID). Để trống: backend tự sinh cặp khóa lần đầu và lưu vào bảng app_setting (dùng chung mọi instance).
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_SUBJECT=mailto:admin@viettrek.vn

# Feature Flags
ENABLE_ONLINE_PAYMENT=true
ENABLE_REDIRECT_BOOKING=true
ENABLE_CARPOOL=false

# Google OAuth2 Login (chỉ cần Client ID để xác minh ID token)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Deploy ---
# Origin của frontend (cách nhau bởi dấu phẩy, KHÔNG dùng *). Ví dụ: https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Mẫu origin bổ sung (wildcard), cách nhau bởi dấu phẩy — chỉ mẫu hẹp của chính dự án, vd bản preview:
# https://viettrek-app-*-<team>.vercel.app. KHÔNG dùng https://*.vercel.app (ai cũng tạo được trang trên đó).
CORS_ALLOWED_ORIGIN_PATTERNS=
# true: cho thêm http://localhost:* và http://127.0.0.1:* (mọi cổng). Mặc định true khi dev,
# false trên profile prod/supabase.
CORS_ALLOW_DEV_WILDCARDS=false
# Cách lấy IP client sau proxy (rate limit, audit log). Mặc định chỉ tin X-Forwarded-For khi kết nối đến từ dải nội bộ
# (loopback / link-local / private). Đổi khi cần: số lớp proxy ("1"), "true", hoặc danh sách CIDR.
# TRUST_PROXY=
# Mật khẩu khởi tạo (>= 8 ký tự) cho tài khoản nạp bằng script SQL; backend băm BCrypt khi khởi động.
# Khi DB không còn ADMIN nào đang hoạt động và APP_SEED_ADMIN_EMAIL chưa tồn tại, backend tạo ADMIN đó với mật khẩu này.
# Profile prod/supabase không có mặc định — DB mới cần seed thì đặt rõ ràng, rồi xóa biến sau khi đăng nhập lần đầu.
APP_SEED_INITIAL_PASSWORD=
APP_SEED_ADMIN_EMAIL=admin@dulichso.vn
# Nạp dữ liệu mẫu màn Admin — như bản Java, cờ này hiện chưa nạp gì (mặc định false).
APP_SEED_DEMO_DATA=false
APP_SEED_DEMO_PASSWORD=

# --- Job định kỳ (dọn dữ liệu quá hạn lưu giữ, nhắc giờ lịch trình, tự trả phòng) ---
# in-process: bộ hẹn giờ chạy nền trong tiến trình (dev, VPS, Docker chạy liên tục): mỗi phút một lượt tick.
# external: tắt bộ hẹn giờ, job chạy khi cron bên ngoài (Vercel Cron: backend-api/vercel.json) gọi mỗi phút
# GET /api/internal/cron/tick. Mặc định: in-process; profile supabase: external.
# APP_SCHEDULING_MODE=external
# Secret cho /api/internal/cron/tick — BẮT BUỘC khi chạy external (Vercel Cron tự gửi "Authorization: Bearer <CRON_SECRET>"
# khi project có biến này). Để trống thì endpoint trả 404 và job KHÔNG chạy ở chế độ external.
# Sinh: openssl rand -hex 32
CRON_SECRET=
# Giờ dọn dữ liệu (giờ Việt Nam, cron 6 trường kiểu Spring: giây phút giờ ngày tháng thứ) và độ dài khung chấp nhận lượt tick (phút).
# RETENTION_CRON=0 30 3 * * *
# RETENTION_WINDOW_MINUTES=15
# Tắt dọn dữ liệu: RETENTION_ENABLED=false
# Số ngày lưu: RETENTION_AUDIT_LOG_DAYS=180, RETENTION_RESET_TOKEN_DAYS=7, RETENTION_NOTIFICATION_DAYS=90
# Chu kỳ tự trả phòng riêng ở chế độ in-process (ms): APP_STAY_AUTO_CHECKOUT_DELAY_MS=300000
# APP_STAY_AUTO_CHECKOUT_INITIAL_DELAY_MS=60000

# --- Pool kết nối PostgreSQL (tên biến giữ nguyên từ bản Hikari) ---
# Mặc định 20 (profile supabase: 5, vì pooler giới hạn kết nối). Cổng 6543 (transaction pooler) tự tắt prepared statement.
# HIKARI_MAX_POOL_SIZE=5
# HIKARI_MIN_IDLE=1
# HIKARI_CONN_TIMEOUT=10000
# HIKARI_IDLE_TIMEOUT=120000
# HIKARI_MAX_LIFETIME=300000
# Thời gian chờ request đang chạy khi container tắt (giây).
# SHUTDOWN_TIMEOUT_SECONDS=20
# Mức log: debug | info | warn | error
# LOG_LEVEL=info

# --- Email (quên mật khẩu bằng OTP) ---
# Email gửi ĐỒNG BỘ trong request (container serverless không chạy việc nền sau khi trả phản hồi).
# Cách 1 (khuyên dùng trên Vercel): Resend HTTPS API — đặt RESEND_API_KEY và MAIL_FROM (domain đã xác minh ở Resend).
RESEND_API_KEY=
# Cách 2: SMTP. Gmail: bật xác minh 2 bước rồi tạo App Password 16 ký tự.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
# MAIL_FROM=Du Lich So <no-reply@your-domain.vn>
# Timeout gọi Resend / SMTP (ms).
# MAIL_TIMEOUT_MS=5000
# MAIL_CONNECT_TIMEOUT_MS=2000
# Thời gian phản hồi tối thiểu của /forgot-password (ms) để không lộ tài khoản có tồn tại hay không.
# PASSWORD_RESET_MIN_RESPONSE_MS=1500
# CHỈ dùng khi dev để in OTP ra log — profile prod/supabase luôn tắt, đặt biến này cũng không có tác dụng
# PASSWORD_RESET_LOG_OTP=false
