# Frontend Environment Variables Example (Vite)

# Origin của backend khi frontend gọi API KHÁC domain, vd chạy dev với backend local:
#   VITE_API_URL=http://localhost:58080
# VITE_API_URL được ưu tiên, VITE_API_ORIGIN là tên cũ (dùng khi VITE_API_URL không được khai báo).
# Production (Vercel) để TRỐNG cả hai: frontend gọi "/api/..." cùng domain và frontend-pwa/vercel.json
# chuyển tiếp sang backend — không CORS, không preflight. Biến môi trường của project Vercel ghi đè
# .env.production, nên cũng không đặt hai biến này trong Environment Variables của project frontend.
# Dev không đặt biến nào thì dùng proxy "/api" của Vite (vite.config.ts → http://127.0.0.1:8080).
VITE_API_URL=
VITE_API_ORIGIN=

# VietMap Map & Tile API Key (Dùng Tilemap Consumer Key để tải bản đồ nền)
# LƯU Ý: Phải là key của Consumer loại "Tilemap", không dùng key "APIs Services"
VITE_VIETMAP_API_KEY=your_vietmap_tilemap_api_key_here

# Google Maps API (Client Restricted Key)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_client

# Cloudinary Upload Setup
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Google OAuth2 Login
VITE_GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Firebase Client SDK (Google One-Click Authentication & Notifications)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Bản đồ nền (tile) — VietMap có gói miễn phí: https://console.vietmap.vn
# Tạo consumer loại "Tilemap" rồi dán key vào đây. Chưa có key thì bản đồ chỉ hiển thị
# marker trên nền trung tính (không tự fallback OSM vì tiêu chí bản đồ chủ quyền Việt Nam).
VITE_VIETMAP_API_KEY=

# Trang chính thức (mã QR nhận phòng của homestay luôn trỏ về đây). Production / Preview lấy từ .env.production;
# chạy dev để trống thì mã trỏ về địa chỉ đang mở.
VITE_PUBLIC_SITE_URL=
