# Cấu hình tối thiểu của backend Node.js (PostgreSQL).
# Danh sách đầy đủ biến môi trường (Supabase/Vercel, CRON_SECRET, RESEND_API_KEY, CORS_ALLOWED_ORIGIN_PATTERNS...)
# nằm ở backend-api/.env.example. Dev local: đặt vào backend-api/.env.local (đã git-ignore).

# ============================================================
# DATABASE
# ============================================================
# Dạng postgres://user:pass@host:5432/db?sslmode=require (dạng jdbc:postgresql://... vẫn được chấp nhận).
# Vercel + Supabase: dùng Transaction pooler (cổng 6543), vd
#   postgres://postgres.<project-ref>:<PASSWORD>@<pooler-host>:6543/postgres?sslmode=require
DB_URL=postgres://postgres:change_me@localhost:5432/viettrek

# ============================================================
# APPLICATION
# ============================================================
PORT=8080
# dev (mặc định) | prod (VPS) | supabase (Vercel + Supabase)
APP_PROFILE=dev
# Chuỗi ngẫu nhiên >= 32 ký tự (openssl rand -base64 48); bắt buộc trên profile prod/supabase.
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long
# Origin của frontend, cách nhau bởi dấu phẩy, KHÔNG dùng *.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Secret cho cron (Vercel Cron) — bắt buộc khi APP_PROFILE=supabase (openssl rand -hex 32).
CRON_SECRET=

# ============================================================
# EMAIL (OTP quên mật khẩu) — khuyên dùng Resend trên Vercel
# ============================================================
RESEND_API_KEY=
MAIL_FROM=
